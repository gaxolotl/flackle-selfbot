{
  "name": "flackle-selfbot",
  "version": "0.2.0",
  "description": "Unofficial Bun/TypeScript client and selfbot library for Flackle",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "check:api": "bun run scripts/read-api.ts",
    "test": "bun test",
    "example:watch": "bun run examples/watch.ts",
    "example:send": "bun run examples/send.ts"
  },
  "keywords": [
    "flackle",
    "selfbot",
    "client",
    "bun"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
