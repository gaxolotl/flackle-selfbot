{
  "$schema": "https://typedoc.org/schema.json",
  "name": "flackle-selfbot",
  "entryPoints": ["src/index.ts"],
  "entryPointStrategy": "resolve",
  "tsconfig": "tsconfig.json",
  "out": "docs/api",
  "readme": "docs/api-readme.md",
  "includeVersion": true,
  "navigationLinks": {
    "Docs home": "../index.html"
  },
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "categorizeByGroup": true,
  "cleanOutputDir": true,
  "searchInComments": true,
  "sort": ["source-order"],
  "groupOrder": ["Classes", "Interfaces", "Type Aliases", "Variables", "Functions"],
  "validation": {
    "notExported": false,
    "invalidLink": false,
    "notDocumented": false
  }
}
