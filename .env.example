# Fill these in, then run `bun run examples/watch.ts`.
# Bun loads .env automatically.
FLACKLE_EMAIL=
FLACKLE_PASSWORD=

# For examples/send.ts:
FLACKLE_SERVER_ID=
FLACKLE_CHANNEL_ID=
# ...or a DM/group conversation:
FLACKLE_CONVERSATION_ID=

# Optional for `bun run check:api`:
FLACKLE_SEARCH_QUERY=test
